{
  "name": "window-resizer-extension",
  "displayName": "Window & Viewport Resizer",
  "version": "0.2.0",
  "description": "指定サイズへウィンドウ/ビューポートをリサイズし、表示部分/ページ全体のスクリーンショットを撮影できるChrome拡張機能",
  "author": "cline-sample-ext_claude",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/storage": "1.15.0",
    "plasmo": "0.90.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "@types/node": "22.13.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "svgo": "3.3.2",
    "typescript": "5.8.2"
  },
  "manifest": {
    "host_permissions": [
      "<all_urls>"
    ],
    "permissions": [
      "tabs",
      "activeTab",
      "storage",
      "downloads",
      "scripting",
      "debugger",
      "system.display"
    ]
  },
  "allowScripts": {
    "lmdb": true,
    "@parcel/watcher": true,
    "@swc/core": true,
    "esbuild": true,
    "msgpackr-extract": true,
    "sharp": true
  }
}
